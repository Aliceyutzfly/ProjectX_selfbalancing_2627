// Practical 1: Basic motor test (XIAO ESP32-C3)

constexpr int MOTOR_IN1 = D0;
constexpr int MOTOR_IN2 = D1;
constexpr int MOTOR_IN3 = D2;
constexpr int MOTOR_IN4 = D3;

void setup() {
  pinMode(MOTOR_IN1, OUTPUT);
  pinMode(MOTOR_IN2, OUTPUT);
  pinMode(MOTOR_IN3, OUTPUT);
  pinMode(MOTOR_IN4, OUTPUT);
}

void loop() {
  // Run both motors in one electrical direction
  analogWrite(MOTOR_IN1, 255);
  analogWrite(MOTOR_IN2, 0);
  analogWrite(MOTOR_IN3, 255);
  analogWrite(MOTOR_IN4, 0);
  delay(2000);

  // Stop (coast) for one second
  analogWrite(MOTOR_IN1, 0);
  analogWrite(MOTOR_IN3, 0);
  delay(1000);

    // Reverse both motors
  analogWrite(MOTOR_IN1, 0);
  analogWrite(MOTOR_IN2, 255);
  analogWrite(MOTOR_IN3, 0);
  analogWrite(MOTOR_IN4, 255);
  delay(2000);

  // Stop (coast) for one second
  analogWrite(MOTOR_IN2, 0);
  analogWrite(MOTOR_IN4, 0);
  delay(1000);
}

